/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Aperture-MRD modules config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process configuration for ext.args, ext.prefix, and publishDir overrides.

    NOTE: Many modules currently define publishDir inline. This config provides
    overrides and ext.args for processes that need them. As modules are refactored,
    publishDir should move here exclusively.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ---- Preprocessing ----

    withName: FASTP {
        ext.args = {
            [
                '--qualified_quality_phred 15',
                params.trim_nextseq ? '--trim_poly_g' : '',
                params.length_required > 0 ? "--length_required ${params.length_required}" : '',
                // if number of lines < split_fastq, fastp will create at least one chunk per cpu allocated
                params.split_fastq > 0 ? "--split_by_lines ${params.split_fastq * 4}" : '',
                params.max_r1_length > 0 ? "--max_len1 ${params.max_r1_length}": '',
                params.max_r2_length > 0 ? "--max_len2 ${params.max_r2_length}" :'',
            ].minus('').join(' ')
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/${workflow.runName}/reports/fastp/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.{html,json,log}",
            ],
            [
                path: { "${params.outdir}/${workflow.runName}/preprocessing/fastp/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.fastq.gz",
                enabled: params.save_fastqs,
            ],
        ]
    }

    withName: SAMTOOLS_MARKDUP {
        publishDir = [
            [
                path: { "${params.outdir}/${workflow.runName}/preprocessing/markduplicates/${meta.id}/" },
                mode: params.publish_dir_mode,
                pattern: "*.{cram,crai}",
            ],
            [
                path: { "${params.outdir}/${workflow.runName}/reports/" },
                mode: params.publish_dir_mode,
                pattern: "*.metrics",
            ],
        ]
    }

    // ---- Alignment ----

    withName: BWA_MEM {
        ext.args = '-K 100000000'
        ext.when   = { params.aligner == 'bwamem' }
    }

    withName: BWAMEM2_MEM {
        ext.args = '-K 100000000'
        ext.when   = { params.aligner == 'bwamem2' }
    }

    // See the docs for recommended settings:
    // https://bwa-mem3.readthedocs.io/en/latest/user-guide/aligning.html
    // https://bwa-mem3.readthedocs.io/en/latest/best-practices/settings-profiles.html
    // -K 100_000_000 : process same number of reads per chunk rather than split based on core count for reproducibility across different machines
    // --bam=0 : pipe uncompressed bam directly to samtools to avoid uncessary sam write/read step
    // -m 10 : reduced mate-rescue depth from 50 to 10
    // -y : disable 3rd-round seeding occurrence from 20
    // apply additional tweaks in fast mode
    // TODO: Add meth and longer reads/SBX modes; meth also needs a meth index!!
    withName: BWAMEM3_MEM {
        ext.args = { [
            '-K 100000000 -m 10 -y 0 --bam=0',
            params.bwamem3_fast ? '--min-ext-len 30 --smem-dedup --skip-contained-ext --max-extend-chains 5 --adaptive-band --extend-mate-concordant' : '',
        ].minus("").join(' ') }
        ext.when   = { params.aligner == 'bwamem3' }
    }

    withName: MINIBWA_MAP {
        ext.args = '-K 100000000'
        ext.when   = { params.aligner == 'minibwa' }
    }

    // Memory is set in the module (scales with genome size); process_high label is
    // omitted there so it doesn't override that. cpus/time mirror process_high here.
    withName: BWAMEM3_INDEX {
        ext.args = ''
        cpus = { 12 * task.attempt }
        time = { 24.h * task.attempt }
    }

    // ---- GATK ----

    withName: GATK4_MARKDUPLICATES {
        ext.args = '--VALIDATION_STRINGENCY LENIENT --OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500'
        publishDir = [
            [
                path: { "${params.outdir}/${workflow.runName}/preprocessing/markduplicates/${meta.id}/" },
                mode: params.publish_dir_mode,
                pattern: "*.{cram,crai}",
            ],
            [
                path: { "${params.outdir}/${workflow.runName}/reports/" },
                mode: params.publish_dir_mode,
                pattern: "*.metrics",
            ],
        ]
    }

    withName: GATK4_BASERECALIBRATOR {
        ext.args = ''
    }

    withName: GATK4_APPLYBQSR {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${workflow.runName}/preprocessing/recal/${meta.id}/" },
            mode: params.publish_dir_mode,
            pattern: "*.{cram,crai}",
        ]
    }

    // ---- Somatic Variant Calling ----

    withName: MUTECT2_SOMATIC {
        ext.args = '--dont-use-soft-clipped-bases'
        publishDir = [
            path: { "${params.outdir}/${workflow.runName}/variant_calling/" },
            mode: params.publish_dir_mode,
            pattern: "*{vcf.gz,vcf.gz.tbi,stats}",
            saveAs: { filename -> meta.num_intervals > 1 ? null : "mutect2/${meta.id}/${filename}" },
        ]
    }

    withName: LEARNREADORIENTATIONMODEL {
        ext.args = ''
    }

    withName: FILTERMUTECTCALLS {
        ext.args = '--min-allele-fraction 0.0'
    }

    withName: STRELKA_SOMATIC {
        ext.args = ''
    }

    withName: MANTA_SOMATIC {
        ext.args = ''
    }

    withName: LOFREQ_SOMATIC {
        ext.args = '--call-indels'
        publishDir = [
            path: { "${params.outdir}/${workflow.runName}/variant_calling/lofreq/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{vcf.gz,vcf.gz.tbi,log}",
        ]
    }

    withName: 'MUSE_CALL' {
        ext.args   = { params.mode == 'wes' ? '-E' : '-G' }
        ext.prefix = { "${meta.id}" } // .MuSE. is added by the tool by default
    }

    withName: 'MSISENSOR2_MSI' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
    }

    // ---- QC ----

    withName: MOSDEPTH {
        ext.args = '--no-per-base --fast-mode'
    }

    withName: SAMTOOLS_STATS {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${workflow.runName}/reports/samtools/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: MULTIQC {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${workflow.runName}/reports/multiqc" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: RIKER_MULTI {
        // default tools: alignment basic isize
        // hybcap (requires both targets AND baits) — file paths are passed via the
        // process's own baits/targets inputs, see modules/fulcrum/riker/multi/main.nf
        // wgs and gcbias tools require --reference
        // reference is also required from cram input
        // https://nf-co.re/docs/developing/components/ext-args
        ext.args = { [
            '--tools basic alignment isize gcbias error',
            params.mode == 'wgs' ? "wgs" : '',
            params.mode == 'wes' && (params.wes_baits && params.wes_targets) ? "hybcap" : '',
        ].minus("").join(' ') }
        publishDir = [
            path: { "${params.outdir}/${workflow.runName}/reports/riker/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    // ---- Consensus ----

    withName: BCFTOOLS_ISEC {
        publishDir = [
            path: { "${params.outdir}/${workflow.runName}/variant_calling/intersection/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    // ---- Blacklist Filtering + gnomAD Exclusion ----

    withName: BEDTOOLS_MERGE {
        ext.prefix = { "${meta.id}.merged" }
    }

    withName: BCFTOOLS_VIEW {
        ext.prefix = { "${meta.id}.blacklist_filtered" }
    }

    withName: GNOMAD_ISEC {
        ext.prefix = { "${meta.id}.compendium" }
        publishDir = [
            path: { "${params.outdir}/${workflow.runName}/variant_calling/gnomad_isec/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    // ---- Annotation ----

    // TODO: simplify nfcore/sarek port below:
    withName: 'ENSEMBLVEP_VEP' {
        ext.args   = { ["--stats_file ",
            meta.variantcaller == 'consensus' ? "${meta.id}.consensus_VEP.ann.summary.html" : vcf.baseName - '.vcf' + '_VEP.ann.summary.html',
            (params.vep_condel && params.condel_config)                           ? "--plugin Condel,${params.condel_config},b"                                                                            : '',
            (params.vep_dbnsfp && params.dbnsfp && !params.dbnsfp_consequence)    ? "--plugin dbNSFP,${params.dbnsfp.split("/")[-1]},${params.dbnsfp_fields}"                                              : '',
            (params.vep_dbnsfp && params.dbnsfp && params.dbnsfp_consequence)     ? "--plugin dbNSFP,'consequence=${params.dbnsfp_consequence}',${params.dbnsfp.split("/")[-1]},${params.dbnsfp_fields}"   : '',
            (params.vep_loftee)                                                   ? "--plugin LoF,loftee_path:/usr/local/share/ensembl-vep-${params.vep_version}" : '',
            (params.vep_mastermind && params.mastermind_file)                     ? "--plugin Mastermind,file=${params.mastermind_file},mutations=${params.mastermind_mutations ? 1 : 0},var_iden=${params.mastermind_var_iden ? 1 : 0},url=${params.mastermind_url ? 1 : 0}" : '',
            (params.vep_phenotypes)                                               ? "--plugin Phenotypes${params.phenotypes_file ? ",file=${params.phenotypes_file.split("/")[-1]}" : ''}${params.phenotypes_include_types ? ",include_types=${params.phenotypes_include_types}" : ''}" : '',
            (params.vep_spliceai && params.spliceai_snv && params.spliceai_indel) ? "--plugin SpliceAI,snv=${params.spliceai_snv.split("/")[-1]},indel=${params.spliceai_indel.split("/")[-1]}"            : '',
            (params.vep_spliceregion)                                             ? '--plugin SpliceRegion'                                                                                                : '',
            (params.vep_out_format)                                               ? "--${params.vep_out_format}"                                                                                           : '--vcf',
            (params.vep_custom_args)                                              ?: ''
        ].join(' ').trim() }
        // If just VEP: <vcf prefix>_VEP.ann.vcf
        ext.prefix = { meta.variantcaller == 'consensus' ? "${meta.id}.consensus_VEP.ann" : vcf.baseName - '.vcf' + '_VEP.ann' }
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/reports/EnsemblVEP/${meta.variantcaller}/${meta.id}/" },
                pattern: "*html"
            ],
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/annotation/${meta.variantcaller}/${meta.id}/" },
                pattern: "*{gz,tbi}"
            ]
        ]
    }
}
