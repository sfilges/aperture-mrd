/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Aperture-MRD modules config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process configuration for ext.args, ext.prefix, and publishDir overrides.

    NOTE: Many modules currently define publishDir inline. This config provides
    overrides and ext.args for processes that need them. As modules are refactored,
    publishDir should move here exclusively.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ---- Preprocessing ----

    withName: FASTQC {
        cpus   = { 4    * task.attempt }
        memory = { 4.GB * task.attempt }
    }

    withName: FASTP {
        cpus   = { 12   * task.attempt }
        memory = { 4.GB * task.attempt }
        ext.args = {
            [
                '--qualified_quality_phred 15',
                params.trim_nextseq ? '--trim_poly_g' : '',
                params.length_required > 0 ? "--length_required ${params.length_required}" : '',
                // if number of lines < split_fastq, fastp will create at least one chunk per cpu allocated
                params.split_fastq > 0 ? "--split_by_lines ${params.split_fastq * 4}" : '',
                params.max_r1_length > 0 ? "--max_len1 ${params.max_r1_length}": '',
                params.max_r2_length > 0 ? "--max_len2 ${params.max_r2_length}" :'',
            ].minus('').join(' ')
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/${params.run_id}/reports/fastp/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.{html,json,log}",
            ],
            [
                path: { "${params.outdir}/${params.run_id}/preprocessing/fastp/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.fastq.gz",
                enabled: params.save_fastqs,
            ],
        ]
    }

    // ---- Alignment ----

    withName: BWA_MEM {
        ext.args = { meta.status == 1 ? '-K 100000000 -Y -B 3' : '-K 100000000 -Y' }
        ext.when   = { params.aligner == 'bwamem' }
    }

    withName: BWAMEM2_MEM {
        ext.args = { meta.status == 1 ? '-K 100000000 -Y -B 3' : '-K 100000000 -Y' }
        ext.when   = { params.aligner == 'bwamem2' }
    }

    // See the docs for recommended settings:
    // https://bwa-mem3.readthedocs.io/en/latest/user-guide/aligning.html
    // https://bwa-mem3.readthedocs.io/en/latest/best-practices/settings-profiles.html
    // -K 100_000_000 : process same number of reads per chunk rather than split based on core count for reproducibility across different machines
    // -Y : Soft clipping on supplementary alignments
    // --bam=0 : pipe uncompressed bam directly to samtools to avoid uncessary sam write/read step
    // -m 10 : reduced mate-rescue depth from 50 to 10
    // -y : disable 3rd-round seeding occurrence from 20
    // apply additional tweaks in fast mode
    // TODO: Add meth and longer reads/SBX modes; meth also needs a meth index!!
    withName: BWAMEM3_MEM {
        ext.args = { [
            '-K 100000000 -Y -m 10 -y 0 --bam=0 --skip-contained-ext --min-ext-len 30',
            meta.status == 1 ? '-B 3' : '',
            params.bwamem3_fast ? '--smem-dedup --max-extend-chains 5 --adaptive-band --extend-mate-concordant' : '',
        ].minus("").join(' ') }
        // samtools sort options (second tool in the pipe). -m is the per-thread sort
        // buffer; larger = fewer temp spills and a shallower final merge, but it must
        // stay within the process memory reservation (sort_cpus * -m + index).
        ext.args2  = ''
        ext.when   = { params.aligner == 'bwamem3' }
    }

    withName: MINIBWA_MAP {
        ext.args = '-K 100000000 -Y'
        ext.when   = { params.aligner == 'minibwa' }
    }

    // Peak memory for bwa-mem3 is: resident index + per-batch working set (+ samtools sort (~12GB at '-m 2G'))
    // for hg38 index = 15 GB
    // no -K     effective batch = chunk_size × n_threads   (chunk_size default 10,000,000)
    // -K INT    effective batch = INT                       (fixed, regardless of n_threads)
    withName: 'BWA_MEM|BWAMEM2_MEM|BWAMEM3_MEM|MINIBWA_MAP' {
        cpus   = { 14    * task.attempt }
        memory = { 28.GB * task.attempt }
    }

    // Memory is set in the module (scales with genome size); process_high label is
    // omitted there so it doesn't override that. cpus/time mirror process_high here.
    withName: BWAMEM3_INDEX {
        ext.args = ''
        cpus = { 12 * task.attempt }
        time = { 24.h * task.attempt }
    }

    withName: 'PARABRICKS_FQ2BAM' {
        ext.args   = { [
            // Using specific read group tags for mutect compability
            "--read-group-id-prefix ${meta.sample_lane_id}",
            "--read-group-sm ${meta.patient}_${meta.sample}",
            "--read-group-lb ${meta.sample}",
            "--read-group-pl ${params.seq_platform}",
            // Using -B 3 for tumor samples
            meta.status == 1 ? "--bwa-options='-K 100000000 -Y -B 3'" : "--bwa-options='-K 100000000 -Y'",
        ].join(' ').trim() }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/preprocessing/parabricks/${meta.id}/" },
            pattern: "*{cram,crai}",
            saveAs: { params.save_mapped ? it : null }
        ]
    }

    // ---- GATK ----

    withName: 'GATK4_MARKDUPLICATES|SAMTOOLS_MARKDUP' {
        cpus   = { 12     * task.attempt }
        memory = { 28.GB * task.attempt }
        publishDir = [
            [
                path: { "${params.outdir}/${params.run_id}/preprocessing/markduplicates/${meta.id}/" },
                mode: params.publish_dir_mode,
                pattern: "*.{cram,crai}",
            ],
            [
                path: { "${params.outdir}/${params.run_id}/reports/" },
                mode: params.publish_dir_mode,
                pattern: "*.metrics",
            ],
        ]
    }

    withName: SAMTOOLS_MARKDUP {
        ext.args = ''
    }

    withName: GATK4_MARKDUPLICATES {
        ext.args = '--VALIDATION_STRINGENCY LENIENT --OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500'
    }

    withName: GATK4_BASERECALIBRATOR {
        ext.args = ''
    }

    withName: GATK4_APPLYBQSR {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/preprocessing/recal/${meta.id}/" },
            mode: params.publish_dir_mode,
            pattern: "*.{cram,crai}",
        ]
    }

    // ---- Somatic Variant Calling ----

    // TODO: Add args '--genotype-germline-sites --genotype-pon-sites' for downstream use with PureCN
    withName: MUTECT2_SOMATIC {
        ext.args = '--dont-use-soft-clipped-bases'
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/variant_calling/" },
            mode: params.publish_dir_mode,
            pattern: "*{vcf.gz,vcf.gz.tbi,stats}",
            saveAs: { filename -> meta.num_intervals > 1 ? null : "mutect2/${meta.id}/${filename}" },
        ]
    }

    withName: LEARNREADORIENTATIONMODEL {
        ext.args = ''
    }

    // Both aliases default to a prefix of meta.id (the pair id), so the tumour and normal
    // tables arrive at CALCULATECONTAMINATION with identical filenames and collide on staging.
    withName: GETPILEUPSUMMARIES_TUMOR {
        ext.prefix = { "${meta.id}.tumor" }
    }

    withName: GETPILEUPSUMMARIES_NORMAL {
        ext.prefix = { "${meta.id}.normal" }
    }

    withName: FILTERMUTECTCALLS {
        ext.args = '--min-allele-fraction 0.0'
    }

    withName: STRELKA_SOMATIC {
        ext.args = ''
        // Scattered over interval chunks that all share meta.id, so the chunk name has to be
        // in the filename for CONCAT_STRELKA to stage the pieces side by side.
        ext.prefix = { "${meta.id}.${target_bed.name - '.bed.gz'}" }
    }

    withName: CONCAT_STRELKA {
        ext.prefix = { "${meta.id}.strelka_snvs" }
    }

    withName: MANTA_SOMATIC {
        cpus   = { 12 }
        memory = { 28.GB }
        ext.args   = { params.mode == 'wes' ? "--exome" : '' }
        ext.args = ''
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/${params.run_id}/variant_calling/manta/${meta.id}" },
            pattern: "*{diploid_sv,tumor_sv,somatic_sv}.{vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: LOFREQ_SOMATIC {
        ext.args = '--call-indels'
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/variant_calling/lofreq/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*{vcf.gz,vcf.gz.tbi,log}",
        ]
    }

    withName: 'MUSE_CALL' {
        ext.args   = { params.mode == 'wes' ? '-E' : '-G' }
        ext.prefix = { "${meta.id}" } // .MuSE. is added by the tool by default
    }

    withName: 'MSISENSOR2_MSI' {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
    }

    // ---- QC ----

    withName: MULTIQC {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/reports/multiqc" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: RIKER_MULTI {
        // default tools: alignment basic isize
        // hybcap (requires both targets AND baits) — file paths are passed via the
        // process's own baits/targets inputs, see modules/fulcrum/riker/multi/main.nf
        // wgs and gcbias tools require --reference; reference is also required from cram input
        // https://nf-co.re/docs/developing/components/ext-args
        // Possible bug in v0.4.1: "--error::stratify-by is required when error is selected"
        // Runtime for '--tools basic alignment isize gcbias wgs' is approx 6.6 sec per 5M reads at 8 cores
        // setting 'error' significantly increases runtime
        ext.args = { [
            '--tools basic alignment isize gcbias',
            params.mode == 'wgs' ? "wgs" : '',
            params.mode == 'wes' && (params.wes_baits && params.wes_targets) ? "hybcap" : '',
        ].minus("").join(' ') }
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/reports/riker/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    // ---- Consensus ----

    // Both aliases of BCFTOOLS_NORM default to ${meta.id}.norm.vcf.gz, so their outputs
    // collide when BCFTOOLS_ISEC stages them together.
    withName: NORM_MUTECT2 {
        ext.prefix = { "${meta.id}.mutect2" }
    }

    withName: NORM_STRELKA {
        ext.prefix = { "${meta.id}.strelka" }
    }

    withName: BCFTOOLS_ISEC {
        publishDir = [
            path: { "${params.outdir}/${params.run_id}/variant_calling/intersection/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    // ---- Blacklist Filtering + gnomAD Exclusion ----

    withName: BEDTOOLS_MERGE {
        ext.prefix = { "${meta.id}.merged" }
    }

    withName: BCFTOOLS_VIEW {
        ext.prefix = { "${meta.id}.blacklist_filtered" }
    }

    withName: GNOMAD_ISEC {
        ext.args = '-C'
        ext.prefix = { "${meta.id}.compendium" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/${params.run_id}/variant_calling/gnomad_isec/${meta.id}" },
        ]
    }

    // ---- CNVs ----

    withName: CNVKIT_BATCH {
        ext.args = { params.wes ? "--method hybrid --diagram --scatter" : "--method wgs --diagram --scatter" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/${params.run_id}/variant_calling/cnvkit/${meta.id}/" },
            pattern: "*{bed,cnn,cnr,cns,pdf,png}"
        ]
    }

    // ---- Annotation ----
    // --everything : Shortcut flag to switch on all of the following:
    //                  --sift b, --polyphen b, --ccds, --hgvs, --symbol, --numbers, --domains, --regulatory, --canonical, --protein, 
    //                  --biotype, --af, --af_1kg, --af_gnomade, --af_gnomadg, --max_af, --pubmed, --uniprot, --mane, --tsl, --appris, 
    //                  --variant_class, --gene_phenotype, --mirna 
    withName: 'ENSEMBLVEP_VEP' {
        ext.args   = { [
            "--everything --stats_file --compress_output bgzip ",
            (params.vep_out_format) ? "--${params.vep_out_format}" : '--vcf',
            (params.vep_custom_args)?: ''
        ].join(' ').trim() }
        // If just VEP: <vcf prefix>_VEP.ann.vcf
        ext.prefix = { "${meta.id}_${meta.variantcaller}_VEP.ann" }
        ext.when   = { params.vep_mode == 'ensembl' }
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/${params.run_id}/reports/EnsemblVEP/${meta.variantcaller}/${meta.id}/" },
                pattern: "*html"
            ],
            [
                mode: params.publish_dir_mode,
                path: { "${params.outdir}/${params.run_id}/annotation/${meta.variantcaller}/${meta.id}/" },
                pattern: "*{gz,tbi}"
            ]
        ]
    }

    withName: 'FASTVEP_ANNOTATE' {
        ext.when   = { params.vep_mode == 'fast' }
    }
}
