/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Aperture-MRD modules config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process configuration for ext.args, ext.prefix, and publishDir overrides.

    NOTE: Many modules currently define publishDir inline. This config provides
    overrides and ext.args for processes that need them. As modules are refactored,
    publishDir should move here exclusively.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ---- Preprocessing ----

    withName: FASTP {
        ext.args = [
            '--qualified_quality_phred 15',
            '--length_required 50',
        ].join(' ')
    }

    // ---- Alignment ----

    withName: BWA_MEM {
        ext.args = '-K 100000000'
        ext.when   = { params.aligner == 'bwamem' }
    }

    withName: BWAMEM2_MEM {
        ext.args = '-K 100000000'
        ext.when   = { params.aligner == 'bwamem2' }
    }

    // See the docs for recommended settings:
    // https://bwa-mem3.readthedocs.io/en/latest/user-guide/aligning.html
    // https://bwa-mem3.readthedocs.io/en/latest/best-practices/settings-profiles.html
    // -K 100_000_000 : process same number of reads per chunk rather than split based on core count for reproducibility across different machines
    // --bam=0 : pipe uncompressed bam directly to samtools to avoid uncessary sam write/read step
    // -m 10 : 
    withName: BWAMEM3_MEM {
        ext.args = '-K 100000000 --bam=0 -m 10 -y 0'
        ext.when   = { params.aligner == 'bwamem3' }
    }

    withName: MINIBWA_MAP {
        ext.args = '-K 100000000'
        ext.when   = { params.aligner == 'minibwa' }
    }

    // Memory is set in the module (scales with genome size); process_high label is
    // omitted there so it doesn't override that. cpus/time mirror process_high here.
    withName: BWAMEM3_INDEX {
        cpus = { 12 * task.attempt }
        time = { 24.h * task.attempt }
    }

    // ---- GATK ----

    withName: GATK4_MARKDUPLICATES {
        ext.args = '--VALIDATION_STRINGENCY LENIENT --OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500'
    }

    withName: GATK4_BASERECALIBRATOR {
        ext.args = ''
    }

    withName: GATK4_APPLYBQSR {
        ext.args = ''
    }

    // ---- Somatic Variant Calling ----

    withName: MUTECT2_SOMATIC {
        ext.args = '--dont-use-soft-clipped-bases'
    }

    withName: LEARNREADORIENTATIONMODEL {
        ext.args = ''
    }

    withName: FILTERMUTECTCALLS {
        ext.args = '--min-allele-fraction 0.0'
    }

    withName: STRELKA_SOMATIC {
        ext.args = ''
    }

    withName: MANTA_SOMATIC {
        ext.args = ''
    }

    withName: LOFREQ_SOMATIC {
        ext.args = '--call-indels'
    }

    withName: 'MUSE_CALL' {
        ext.args   = { params.mode == 'wes' ? '-E' : '-G' }
        ext.prefix = { "${meta.id}" } // .MuSE. is added by the tool by default
    }

    // ---- QC ----

    withName: MOSDEPTH {
        ext.args = '--no-per-base --fast-mode'
    }

    withName: SAMTOOLS_STATS {
        ext.args = ''
    }

    withName: MULTIQC {
        ext.args = ''
    }

    // ---- Blacklist Filtering + gnomAD Exclusion ----

    withName: BEDTOOLS_MERGE {
        ext.prefix = { "${meta.id}.merged" }
    }

    withName: BCFTOOLS_VIEW {
        ext.prefix = { "${meta.id}.blacklist_filtered" }
    }

    withName: GNOMAD_ISEC {
        ext.prefix = { "${meta.id}.compendium" }
    }
}
