/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Aperture-MRD base config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default resource allocations for all processes.
    Process labels map to resource tiers; individual processes inherit from these.
    Override per-process in conf/modules.config or profile-specific configs.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // Default
    cpus   = 1
    memory = 6.GB
    time   = 4.h

    // Error handling: retry with increased resources on common transient failures
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 12 * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withLabel: process_long {
        time = { 48.h * task.attempt }
    }

    withLabel: process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    withLabel: process_gpu {
        accelerator = [request: 1, type: 'nvidia-tesla-a10g']
        cpus   = 8
        memory = 60.GB
        time   = 12.h
    }

    withName: 'BWA_MEM|BWAMEM2_MEM|BWAMEM3_MEM|MINIBWA_MAP' {
        cpus   = { 16    * task.attempt }
        memory = { 30.GB * task.attempt }
    }

    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}
