manifest {
    name = 'aperture-mrd'
    author = 'Stefan Filges'
    description = 'WGS - Workflow for ctDNA detection from whole genome sequencing data'
    homePage = 'http://simsendiagnostics.com'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version = '0.4.0'
}

// Define environment variables
// Limit java virtual machine resource usage on VMs
//env {
//  NXF_OPTS="-Xms1g -Xmx8g"
//  NXF_JVM_ARGS="-Xms1g -Xmx4g"
//}

validation {
    help {
        enabled     = true
        command     = "nextflow run sfilges/aperture-mrd -profile docker --input samplesheet.csv --outdir results"
        beforeText  = "Aperture-MRD — ctDNA detection from WGS\n"
        afterText   = "See https://github.com/sfilges/aperture-mrd for docs.\n"
    }
}


params {
    // I/O options
    input = null
    outdir = null
    publish_dir_mode = 'copy'

    // Groups every output of one invocation under ${outdir}/${run_id}.
    run_id = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // Nextflow options
    validate_params = true

    // Mandatory arguments
    step = 'fastq2bam'
    // Alternatives: 'fastq2bam', 'variant_calling', 'annotate', 'build_cnv_reference'
    aligner = 'bwamem3'
    // Alternatives: 'bwamem', 'bwamem2', 'bwamem3', 'minibwa'
    bwamem3_fast = false

    // Run in 'wgs' or 'wes' mode, default is 'wgs'
    mode = "wgs" 
    // Preprocessing alternatives: 'gatk', 'fast'
    preprocessing = "fast"

    merge_fastqs = false
    save_fastqs = false
    // Split fastq files into chunks of 50 million reads for alignment; 0 disables splitting
    split_fastq = 0
    trim_nextseq = false
    length_required = 50
    save_mapped = true
    max_r1_length = 0
    max_r2_length = 0

    // Number of splits for the interval file, used for split and gather operations
    n_interval_splits = 10
    // How many bases per bed file chunk
    bases_per_chunk = 1_000_000

    // Read group information, required for GATK, will by added during alignment
    // No sequencing center to be written in read group CN field by aligner
    seq_center = null
    // Default platform written in read group PL field by aligner
    seq_platform = 'ILLUMINA'

    // wes mode
    // Baits (probes) describe where the capture oligos actually sit and are the
    // better model of the covered footprint: for the xGen v2 panel 11.0 Mb of
    // probed sequence falls outside the targets file, while 2.8 Mb of targets
    // has no probe behind it. Baits therefore drive CNV binning and variant
    // calling; targets are retained for the other workflows.
    wes_targets = "${projectDir}/assets/panels/idt_xgen_v2/xgen-exome-hyb-panel-v2-targets-hg38.bed"
    wes_baits = "${projectDir}/assets/panels/idt_xgen_v2/xgen-exome-hyb-panel-v2-probes-hg38.bed"
    wes_use_baits_as_intervals = false

    // Padding applied to the *variant calling* intervals only (never to the BED
    // handed to CNVkit, which must stay unpadded — PureCN assumes unpadded
    // targets and applies its own flanking window). Set to 0 to disable.
    interval_padding = 0

    // References
    genome = 'GATK.GRCh38'
    igenomes_base = 's3://ngi-igenomes/igenomes'
    igenomes_ignore = false
    bwa_index = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Sequence/BWAIndex/"
    bwamem2_index = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Sequence/BWAmem2Index/"
    bwamem3_index = null
    minibwa_index = null
    fasta = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta"
    fai = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta.fai"
    dict = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.dict"
    known_indels = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/{Mills_and_1000G_gold_standard.indels.hg38,beta/Homo_sapiens_assembly38.known_indels}.vcf.gz"
    known_indels_tbi = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/{Mills_and_1000G_gold_standard.indels.hg38,beta/Homo_sapiens_assembly38.known_indels}.vcf.gz.tbi"
    known_snps = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/1000G_omni2.5.hg38.vcf.gz"
    known_snps_tbi = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/1000G_omni2.5.hg38.vcf.gz.tbi"
    dbsnp = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/dbsnp_146.hg38.vcf.gz"
    dbsnp_tbi = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/dbsnp_146.hg38.vcf.gz.tbi"
    germline_resource = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/af-only-gnomad.hg38.vcf.gz"
    germline_resource_tbi = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/af-only-gnomad.hg38.vcf.gz.tbi"
    pon = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/1000g_pon.hg38.vcf.gz"
    pon_tbi = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/GATKBundle/1000g_pon.hg38.vcf.gz.tbi"
    msisensor2_models = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/MSIsensor2/models_hg38/"

   // wgs mode
    wgs_intervals = "${params.igenomes_base}/Homo_sapiens/GATK/GRCh38/Annotation/intervals/wgs_calling_regions_noseconds.hg38.bed"

    // Blacklist filtering
    encode_blacklist = "${projectDir}/assets/encode_blacklist_hg38_v2.bed"
    centromeres = "${projectDir}/assets/centromeres.sorted.bed"
    simple_repeats = "${projectDir}/assets/simple_repeat_regions.sorted2.bed"

    // Copy number calling
    // null disables CNV calling. Alternatives: 'cnvkit'
    cnv_caller = null

    // Pre-built pooled reference (.cnn) from a previous 'build_cnv_reference' run.
    // When set it is used for every sample and matched normals are ignored;
    // otherwise tumor-normal pairs use their matched normal and tumor-only
    // samples fall back to a flat reference.
    cnvkit_reference = null

    // Pre-computed accessible-regions BED. When null it is built from the fasta
    // with cnvkit access, excluding the regions below.
    cnvkit_access = null
    // Regions removed from the accessible genome. Deliberately excludes
    // simple_repeats: 23 MB of repeat intervals would fragment the access file
    // and gut antitarget bin sizes. Simple repeats are used as a PureCN SNP
    // blacklist instead, which is what the PureCN docs actually recommend.
    cnvkit_exclude = "${projectDir}/assets/{encode_blacklist_hg38_v2,centromeres.sorted}.bed"

    // Average target bin size. null lets cnvkit autobin decide; CNVkit recommends >=1000 for 30x WGS.
    cnvkit_target_avg_size = null

    // Name given to a reference built by step 'build_cnv_reference'. Used both for the CNVkit panel 
    // and as the PureCN assay name, so a reference bundle stays identifiable as one unit.
    cnv_reference_name = 'panel'

    // PureCN purity/ploidy estimation from the CNVkit output
    purecn = false
    purecn_genome = 'hg38'
    purecn_normaldb = null
    purecn_mapping_bias = null
    // VCF of calls across the normals, used to build the mapping bias database during 'build_cnv_reference'. 
    // Without it only the coverage-based normalDB is produced.
    purecn_normal_panel = null

    // VEP annotation
    // Path to VEP cache directory (required for annotation)
    // Ensembl strongly recommends that you download/use the cache version which corresponds to your Ensembl VEP installation,
    // i.e. cache version 116 should be used with the Ensembl VEP tool version 116. 
    vep_cache = null
    vep_cache_version = '116'
    vep_genome = 'GRCh38'
    vep_species = 'homo_sapiens'
    vep_out_format = 'vcf'
    vep_mode = 'ensembl' // ensembl or fast
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// Docker parameters
docker.registry = 'quay.io'
podman.registry = 'quay.io'

// Set default docker run options
// label=disable exempts containers from SELinux labelling. Nextflow bind-mounts the
// common parent of the work dir and inputs (often $HOME), so relabelling via ':z'
// would rewrite that whole tree. Ignored on non-SELinux hosts.
docker.runOptions = '-u $(id -u):$(id -g) --security-opt label=disable'
podman.runOptions = '--security-opt label=disable'

profiles {
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --security-opt label=disable --platform=linux/amd64'
        podman.runOptions = '--security-opt label=disable --platform=linux/amd64'
    }

    gpu {
        docker.runOptions = '-u $(id -u):$(id -g) --security-opt label=disable --gpus all'
        podman.runOptions = '--security-opt label=disable --gpus all'
    }

    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        wave.enabled = false
    }

    docker {
        docker.enabled = true
        podman.enabled = false
        singularity.enabled = false
    }

    podman {
        docker.enabled = false
        podman.enabled = true
        singularity.enabled = false
    }

    singularity {
        docker.enabled = false
        podman.enabled = false
        singularity.enabled = true
    }
}


// Nextflow plugins from nf-core
plugins {
    id 'nf-schema@2.7.3'
}


timeline {
    enabled = true
    file    = "${params.outdir}/${params.run_id}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/${params.run_id}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/${params.run_id}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/${params.run_id}/pipeline_info/pipeline_dag.html"
}
